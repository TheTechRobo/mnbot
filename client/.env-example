# Defines the unique tracker URL.
# NB: The tracker URL will be different for each pipeline,
# even for pipelines running on the same host.
#TRACKER_URL="wss://example.com"

# Upload target.
#RSYNC_URL=

# Rsync password, if required.
#RSYNC_PASSWORD=

# Set to 1 to enable debug logging in the worker.
#WORKER_DEBUG=0

# You may need to change this if you have issues with AppArmor.
APPARMOR_PROFILE=docker-default
# This next one works on my machine with globally-installed apparmor rules.
# See the wiki page on deployment if this doesn't fix the issue.
#APPARMOR_PROFILE=chromium
