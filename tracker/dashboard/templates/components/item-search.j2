<!-- Search box to instantly look up items. Binds the shortcut 'i'. -->
<script>
function validateForm() {
	const e = document.getElementById("search-item");
	e.value = e.value.trim();
	const err = document.getElementById("search-item-usage");
	const erroldid = document.getElementById("search-item-uuid4");
	const isValid = /[0-9a-zA-Z]+\.[0-9a-zA-Z]/i.test(e.value) || /^[0-9A-F]{8}-[0-9A-F]{4}-7[0-9A-F]{3}-[89AB][0-9A-F]{3}-[0-9A-F]{12}$/i.test(e.value);
	if (isValid) {
		e.ariaInvalid = false;
		err.hidden = true;
		erroldid.hidden = true;
		return true;
	} else {
		if (/^[0-9A-F]{8}-[0-9A-F]{4}-4[0-9A-F]{3}-[89AB][0-9A-F]{3}-[0-9A-F]{12}$/i.test(e.value)) {
			erroldid.hidden = false;
			err.hidden = true;
		} else {
			erroldid.hidden = true;
			err.hidden = false;
		}
		e.ariaInvalid = true;
		return false;
	}
}

SHORTCUTS.i = (event) => document.getElementById("search-item").focus();

function makeBusy(is) {
	document.getElementById("search-submit").ariaBusy = is;
}

window.addEventListener("pageshow", (e) => {
	makeBusy(false);
});

function submitItemSearch(event) {
	if (!validateForm()) {
		return false;
	}
	makeBusy(true);
	return true;
}
</script>

<article id="search">
	<h3><span class="shortcut">I</span>tem search</h3>
	<form action="/item/translate" method="GET" id="search-form" onsubmit="return submitItemSearch(event)">
		<fieldset role="group">
			<input
				name="item"
				id="search-item"
				aria-describedby="search-item-helper"
				placeholder="Item identifier"
				aria-label="Item identifier"
				oninput="validateForm()"
				aria-keyshortcuts="d"
			/>
			<button type="submit" id="search-submit">Search</button>
		</fieldset>
		<small id="search-item-helper">You can enter either a job or page ID, or a URL prefix.</small>
		<small class="error" hidden id="search-item-usage">This field should either contain a valid UUID or URL prefix.</small>
		<small class="error error2" hidden id="search-item-uuid4">You've entered a very old item ID. Please see the documentation for more information.</small>
	</form>
</article>
